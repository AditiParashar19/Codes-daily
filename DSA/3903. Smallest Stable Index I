Method 1 

class Solution {
public:
    int firstStableIndex(vector<int>& nums, int k) {
        int n = nums.size();
        int max1 = INT_MIN;
        int min1 = INT_MAX;
        for(int i=0;i<n;i++){
            max1 = max(max1,nums[i]);
            min1 = *min_element(nums.begin()+i,nums.end());
            if((max1-min1)<=k)
                return i;
        }
        return -1;
    }
};

Time Complexity : O(n^2)
