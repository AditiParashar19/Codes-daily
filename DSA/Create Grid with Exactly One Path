class Solution {
public:
    vector<string> createGrid(int m, int n) {
        vector<string>path(m,string(n,'#'));
        for(int i=0;i<n;i++){
            path[0][i] = '.';
        }
        for(int i=1;i<m;i++)
            path[i][n-1] = '.';
    
        return path;
            
    }
};©leetcode
