Solution 1

class Solution {
public:
    string processStr(string s) {
        string str1="";
        for(char ch : s){
            if(str1.length()>0 && ch=='*')
                str1.pop_back();
            else if(ch=='#')
                str1+=str1;
            else if(ch=='%')
                reverse(str1.begin(),str1.end());
            else if(islower(ch))
                str1+=ch;
        }
        return str1;
    }
};

2nd solution

class Solution {
public:
    string processStr(string s) {
        int n = s.size();
        string ans = "";
        for(char c : s){
         if(c >= 'a' && c <= 'z'){
            ans.push_back(c);
         }

         else if(c == '*'){
            if(!ans.empty()) ans.pop_back();
         }
         else if(c=='#'){
            ans+=ans;
         }else if(c == '%'){
            reverse(ans.begin(),ans.end());
         }
        }
        return ans;


    }
};
