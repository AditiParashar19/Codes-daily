class Solution {
public:
    vector<int> spiralOrder(vector<vector<int>>& matrix) {
        vector<int>res;
        int idx = 0;
        int m = matrix.size();
        int n = matrix[0].size();
        vector<int> dr = {0,1,0,-1};
        vector<int> dc = {1,0,-1,0};
        int r=0;
        int c = 0;
        vector<vector<bool>>vis(m,vector<bool>(n,false));
        for(int i=0;i<m*n;i++){
            res.push_back(matrix[r][c]);
            vis[r][c] = true;
            int newr = r + dr[idx];
            int newc = c+  dc[idx];
            if(0<=newr && 0<=newc && newr<m && newc<n && !vis[newr][newc]){
                r = newr;
                c = newc;

            }else{
                idx = (idx+1)%4;
                r+=dr[idx];
                c+=dc[idx];
            }
        }
        return res;
    }
};

--------------------------------------------------------------------------------------------------------------------------------------------------------------------
Time Complexity - O(m*n)
Space Complexity - O(m*n)
